# Скопируйте в .env и заполните
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///data/agent.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FREELANCEHUNT_TOKEN=
FREELANCER_TOKEN=
# Модели (по ТЗ: Sonnet — отклики/профили, Haiku — скоринг)
MODEL_WRITER=claude-sonnet-5-5
MODEL_SCORER=claude-haiku-5-5
# Порог скоринга, выше которого заказ уходит в Telegram
SCORE_NOTIFY_THRESHOLD=60
